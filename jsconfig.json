{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "test/**/*.js",
    "scripts/**/*.js",
    "downtest/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "release",
    "dist"
  ]
}
