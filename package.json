{
  "name": "porn-go",
  "version": "0.9.7",
  "private": true,
  "description": "Desktop video downloader with an embedded website sign-in window.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "verify:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tools.ps1 -VerifyOnly",
    "dist": "npm run check && npm test && npm run verify:tools && electron-builder --win",
    "dist:portable": "npm run check && npm test && npm run verify:tools && electron-builder --win portable",
    "fetch:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tools.ps1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "^26.18.1",
    "typescript": "^6.0.3",
    "typescript-language-server": "^6.0.2"
  },
  "build": {
    "appId": "com.porngo.app",
    "productName": "PornGo",
    "icon": "assets/icon-0.9.2.ico",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon-0.9.2.ico",
        "to": "assets/icon-0.9.2.ico"
      },
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "yt-dlp.exe",
          "ffmpeg.exe",
          "README.md",
          "tool-versions.json",
          "licenses/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "PornGo"
    },
    "nsis": {
      "artifactName": "PornGo-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "PornGo-${version}-portable.exe"
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
